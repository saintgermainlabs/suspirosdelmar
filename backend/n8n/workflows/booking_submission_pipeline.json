      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"submission_id\": \"{{ $('Webhook Trigger').item.json.body.form_type === 'booking' ? $('Insert Booking').item.json.submission_id : $('Insert Submission (Contact)').item.json.submission_id }}\",\n  \"message\": \"Submission processed successfully\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "88888888-8888-4888-8888-888888888888",
      "name": "Respond to Webhook",
