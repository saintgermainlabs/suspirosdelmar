              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"12102912723\",\n  \"text\": \"🌊 *Nueva Solicitud - Los Suspiros del Mar* 🌊\\n\\n👤 *Nombre:* {{ $('Webhook Trigger').item.json.body.name }}\\n📧 *Email:* {{ $('Webhook Trigger').item.json.body.email }}\\n📞 *Teléfono:* {{ $('Webhook Trigger').item.json.body.phone }}\\n📋 *Tipo:* {{ $('Webhook Trigger').item.json.body.form_type }}\\n💬 *Mensaje:* {{ $('Webhook Trigger').item.json.body.message || 'Sin mensaje' }}\"\n}",
