        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "53A9B246CB97-41DB-9A25-FBF2A31508AE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"51953677228\",\n  \"text\": \"🌊 *Nueva Solicitud - Los Suspiros del Mar* 🌊\\n\\n👤 *Nombre:* {{ $('Webhook Trigger').item.json.body.name }}\\n📧 *Email:* {{ $('Webhook Trigger').item.json.body.email }}\\n📞 *Teléfono:* {{ $('Webhook Trigger').item.json.body.phone }}\\n📋 *Tipo:* {{ $('Webhook Trigger').item.json.body.form_type }}\\n💬 *Mensaje:* {{ $('Webhook Trigger').item.json.body.message || 'Sin mensaje' }}\"\n}",
        "options": {}
      },
      "onError": "continueErrorOutput",
