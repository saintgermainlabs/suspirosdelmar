        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"Los Suspiros del Mar <onboarding@resend.dev>\", to: [$('Webhook Trigger').item.json.body.email], subject: \"Confirmación de Solicitud - Los Suspiros del Mar\", html: \"<h2>¡Gracias por contactarnos, \" + ($('Webhook Trigger').item.json.body.name ?? \"\") + \"!</h2><p>Hemos recibido tu solicitud. Nos pondremos en contacto contigo pronto.</p>\" }) }}",
        "options": {}
      },
