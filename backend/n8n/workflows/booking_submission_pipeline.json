{
  "name": "Booking & Form Submission Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "submit",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "submit"
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.form_type }}",
                    "rightValue": "booking",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Booking"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.form_type }}",
                    "rightValue": "contact",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Contact"
            }
          ]
        }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Switch Form Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO submissions (form_type, name, email, phone, status, payload)\nVALUES (\n  '{{ $('Webhook Trigger').item.json.body.form_type }}',\n  '{{ $('Webhook Trigger').item.json.body.name }}',\n  '{{ $('Webhook Trigger').item.json.body.email }}',\n  '{{ $('Webhook Trigger').item.json.body.phone }}',\n  'pending',\n  '{{ JSON.stringify($('Webhook Trigger').item.json.body) }}'::jsonb\n)\nRETURNING id AS submission_id, form_type, name, email, phone;"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Insert Submission (Booking)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        700,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "suspiros_postgres_cred",
          "name": "PostgreSQL suspiros_db"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO bookings (submission_id, guest_name, guest_email, guest_phone, checkin_date, checkout_date, guests_count, room_name, special_requests, status)\nVALUES (\n  '{{ $('Insert Submission (Booking)').item.json.submission_id }}',\n  '{{ $('Webhook Trigger').item.json.body.name }}',\n  '{{ $('Webhook Trigger').item.json.body.email }}',\n  '{{ $('Webhook Trigger').item.json.body.phone }}',\n  '{{ $('Webhook Trigger').item.json.body.checkin }}',\n  '{{ $('Webhook Trigger').item.json.body.checkout }}',\n  {{ $('Webhook Trigger').item.json.body.guests || 1 }},\n  '{{ $('Webhook Trigger').item.json.body.room }}',\n  '{{ $('Webhook Trigger').item.json.body.message }}',\n  'pending'\n)\nRETURNING id AS booking_id, submission_id;"
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Insert Booking",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        920,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "suspiros_postgres_cred",
          "name": "PostgreSQL suspiros_db"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO submissions (form_type, name, email, phone, status, payload)\nVALUES (\n  '{{ $('Webhook Trigger').item.json.body.form_type }}',\n  '{{ $('Webhook Trigger').item.json.body.name }}',\n  '{{ $('Webhook Trigger').item.json.body.email }}',\n  '{{ $('Webhook Trigger').item.json.body.phone }}',\n  'pending',\n  '{{ JSON.stringify($('Webhook Trigger').item.json.body) }}'::jsonb\n)\nRETURNING id AS submission_id, form_type, name, email, phone;"
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Insert Submission (Contact)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        700,
        420
      ],
      "credentials": {
        "postgres": {
          "id": "suspiros_postgres_cred",
          "name": "PostgreSQL suspiros_db"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"Los Suspiros del Mar <reservas@suspirodelmar.com>\",\n  \"to\": [\"{{ $('Webhook Trigger').item.json.body.email }}\"],\n  \"subject\": \"Confirmación de Solicitud - Los Suspiros del Mar\",\n  \"html\": \"<h2>¡Gracias por contactarnos, {{ $('Webhook Trigger').item.json.body.name }}!</h2><p>Hemos recibido tu solicitud de {{ $('Webhook Trigger').item.json.body.form_type }}. Nos pondremos en contacto contigo pronto.</p>\"\n}",
        "options": {}
      },
      "onError": "continueErrorOutput",
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Send Resend Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        300
      ]
    },
